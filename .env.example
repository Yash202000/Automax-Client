VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080
VITE_BASE_PATH=/

VITE_DISABLE_AUTO_LOCATION_RETRIEVAL=true
VITE_ENABLE_GIS=true

# Login methods visibility (set to "false" to hide)
VITE_LOGIN_REGULAR=true
VITE_LOGIN_LDAP=true
VITE_LOGIN_SSO=true

# Only for vd2 client, set to "VD2" to enable vd2 specific features
VITE_CLIENT="VD2"

# CTI provider: "cintrix" embeds the Cintrix CTI widget (CintrixCtiHost) in
# place of the native softphone. Any other value (or unset) keeps native.
# VITE_CTI_PROVIDER=cintrix

# Default SIP password
VITE_SIP_PASSWORD=51234

VITE_APP_VERSION=1.0.2

VITE_ENABLE_SIGNUP = true

# "Nearby Incidents" button on the incident detail page. Must match the
# backend's own NEARBY_INCIDENT_RADIUS_METERS (the actual search radius) —
# if unset here, the button is hidden entirely regardless of the backend.
VITE_NEARBY_INCIDENT_RADIUS_METERS=200

# Maps: with an API key every map uses native Google Maps (and Google Places
# search in the location picker); without one, every map uses OpenStreetMap.
# The key needs: Maps JavaScript API, Places API (New), Geocoding API.
# Restrict it by HTTP referrer (e.g. https://your-domain/*, http://localhost:5173/*).
VITE_GOOGLE_MAPS_API_KEY=AIsfss...s..s.....
# Google Map ID (Cloud Console > Google Maps Platform > Map Management). Required
# by Google's advanced markers; defaults to Google's DEMO_MAP_ID if unset.
# VITE_GOOGLE_MAPS_MAP_ID=your-map-id

